{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Unweb",
  "version": "0.3.1",
  "identifier": "org.unweb.app",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:"
      },
      "capabilities": ["bar", "strip", "compare"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "dmg", "msi"],
    "publisher": "Unweb contributors",
    "copyright": "Copyright 2026 Unweb contributors",
    "license": "Apache-2.0",
    "licenseFile": "../../LICENSE",
    "category": "Utility",
    "shortDescription": "A tiny browser where every visit is a first visit.",
    "longDescription": "Unweb is a small web browser where every window is a stranger: it starts with no history, no logins and no cookies, and when you close it everything it collected is deleted. Several strangers can run side by side, each kept apart from the others and from your normal browser.",
    "homepage": "https://unweb.org",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": { "minimumSystemVersion": "14.0" },
    "windows": { "webviewInstallMode": { "type": "downloadBootstrapper" } }
  }
}
